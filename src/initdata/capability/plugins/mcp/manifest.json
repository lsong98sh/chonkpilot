{
  "schema": "chonkpilot.plugin/v1",
  "id": "mcp",
  "name": "MCP 工具",
  "version": "1.0.0",
  "description": "MCP 系列工具：检索（mcp_find）/ 加载（mcp_load）/ 调用（mcp_invoke）",
  "icon": "plug",
  "publisher": "chonkpilot",
  "product": true,
  "runtime": {
    "mode": "managed",
    "exe": "chonkpilot-plugin-mcp.exe",
    "args": [],
    "autostart": true,
    "restart": { "backoff_ms": 1000, "max_backoff_ms": 30000, "max_fails": 3 },
    "health": { "interval_ms": 15000, "timeout_ms": 3000, "fail_threshold": 3 },
    "stop": { "grace_ms": 5000 }
  },
  "mcp": {
    "mode": "http",
    "namespace": "-",
    "hot_tools": ["mcp_find", "mcp_load", "mcp_invoke"],
    "timeout_sec": 600,
    "category": "meta",
    "origin": "builtin"
  },
  "config": { "scope": "plugin" },
  "ui": {
    "selfServe": true,
    "views": [
      {
        "id": "config",
        "title": "MCP 工具",
        "icon": "plug",
        "entry": "webui/config.html",
        "containers": ["preview", "tab", "drawer", "dialog"],
        "default_size": { "width": 760, "height": 600 }
      }
    ],
    "menus": [
      { "location": "plugin", "label": "MCP 工具", "icon": "plug", "view": "config" }
    ],
    "statusbar": [],
    "rpc": ["status", "ping", "load", "save", "reset"]
  },
  "permissions": {
    "data": [],
    "hooks": [],
    "llm": {},
    "session": [],
    "ui": { "containers": ["preview", "tab", "drawer", "dialog"] },
    "network": []
  }
}
