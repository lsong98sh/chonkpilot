{
  "schema": "chonkpilot.plugin/v1",
  "id": "browser",
  "name": "浏览器",
  "version": "1.0.0",
  "description": "WebView2 浏览器会话（browser_run 工具）",
  "icon": "globe",
  "publisher": "chonkpilot",
  "product": true,
  "runtime": {
    "mode": "managed",
    "exe": "chonkpilot-plugin-browser.exe",
    "args": [],
    "autostart": true,
    "restart": { "backoff_ms": 1000, "max_backoff_ms": 30000, "max_fails": 3 },
    "health": { "interval_ms": 15000, "timeout_ms": 3000, "fail_threshold": 3 },
    "stop": { "grace_ms": 5000 }
  },
  "mcp": {
    "mode": "http",
    "namespace": "-",
    "hot_tools": ["browser_run"],
    "timeout_sec": 180,
    "category": "browser",
    "origin": "builtin"
  },
  "config": { "scope": "prjusr" },
  "ui": {
    "selfServe": true,
    "views": [
      {
        "id": "config",
        "title": "浏览器",
        "icon": "globe",
        "entry": "webui/config.html",
        "containers": ["preview", "tab", "drawer", "dialog"],
        "default_size": { "width": 760, "height": 600 }
      }
    ],
    "menus": [
      { "location": "plugin", "label": "浏览器", "icon": "globe", "view": "config" }
    ],
    "statusbar": [
      {
        "id": "browser",
        "zone": "right",
        "icon": "globe",
        "tooltip": "浏览器插件",
        "command": { "target": "host", "action": "open-view", "view": "config" }
      }
    ],
    "rpc": ["status", "contexts", "ping", "load", "save", "reset"]
  },
  "permissions": {
    "data": [],
    "hooks": [],
    "llm": {},
    "session": [],
    "ui": { "containers": ["preview", "tab", "drawer", "dialog", "statusbar"] },
    "network": []
  }
}
