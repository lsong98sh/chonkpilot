{
  "schema": "chonkpilot.plugin/v1",
  "id": "websearch",
  "name": "联网能力",
  "version": "1.1.0",
  "description": "联网三件套：web_search（DeepSeek 检索）/ web_fetch（抓取转文本）/ web_download（下载到本地）",
  "icon": "search",
  "publisher": "chonkpilot",
  "product": true,
  "runtime": {
    "mode": "managed",
    "exe": "chonkpilot-websearch.exe",
    "args": [],
    "autostart": true,
    "restart": { "backoff_ms": 1000, "max_backoff_ms": 30000, "max_fails": 3 },
    "health": { "interval_ms": 15000, "timeout_ms": 3000, "fail_threshold": 3 },
    "stop": { "grace_ms": 5000 }
  },
  "channel": { "transport": "uds", "addr": "" },
  "mcp": {
    "mode": "http",
    "namespace": "-",
    "hot_tools": ["web_search", "web_fetch", "web_download"],
    "timeout_sec": 180,
    "category": "web",
    "origin": "builtin"
  },
  "config": { "scope": "prjusr" },
  "ui": {
    "selfServe": true,
    "views": [
      {
        "id": "config",
        "title": "联网能力",
        "icon": "search",
        "entry": "webui/config.html",
        "containers": ["preview", "tab", "drawer", "dialog"],
        "default_size": { "width": 820, "height": 680 }
      },
      {
        "id": "status",
        "title": "联网能力状态",
        "icon": "clock",
        "entry": "webui/status.html",
        "containers": ["preview", "tab", "drawer"]
      }
    ],
    "menus": [
      { "location": "plugin", "label": "联网能力", "icon": "search", "view": "config" }
    ],
    "statusbar": [
      {
        "id": "websearch",
        "zone": "right",
        "icon": "search",
        "tooltip": "联网能力",
        "command": { "target": "host", "action": "open-view", "view": "status" }
      }
    ],
    "rpc": ["test", "status", "download-dir", "load", "save", "reset"]
  },
  "permissions": {
    "data": ["storage.self"],
    "hooks": [],
    "llm": {},
    "session": [],
    "ui": { "containers": ["preview", "tab", "drawer", "dialog", "statusbar"] },
    "network": ["*"]
  }
}
