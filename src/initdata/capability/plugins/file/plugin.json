{
  "schema": "chonkpilot.plugin/v1",
  "id": "file",
  "name": "文件工具",
  "version": "1.0.0",
  "description": "文件系列 11 个工具（read/write/replace/patch/diff/find/copy/move/delete/iconv/detect）",
  "icon": "file",
  "publisher": "chonkpilot",
  "product": true,
  "runtime": {
    "mode": "managed",
    "exe": "chonkpilot-plugin-file.exe",
    "args": [],
    "autostart": true,
    "restart": { "backoff_ms": 1000, "max_backoff_ms": 30000, "max_fails": 3 },
    "health": { "interval_ms": 15000, "timeout_ms": 3000, "fail_threshold": 3 },
    "stop": { "grace_ms": 5000 }
  },
  "mcp": {
    "mode": "http",
    "namespace": "-",
    "hot_tools": ["file_read", "file_write", "file_replace", "file_patch", "file_diff", "file_find", "file_copy", "file_move", "file_delete", "file_iconv", "file_detect"],
    "timeout_sec": 300,
    "category": "file",
    "origin": "builtin"
  },
  "config": { "scope": "plugin" },
  "ui": {
    "selfServe": true,
    "views": [
      {
        "id": "config",
        "title": "文件工具",
        "icon": "file",
        "entry": "webui/config.html",
        "containers": ["preview", "tab", "drawer", "dialog"],
        "default_size": { "width": 760, "height": 600 }
      }
    ],
    "menus": [
      { "location": "plugin", "label": "文件工具", "icon": "file", "view": "config" }
    ],
    "statusbar": [],
    "rpc": ["status", "tools", "ping", "load", "save", "reset"]
  },
  "permissions": {
    "data": [],
    "hooks": [],
    "llm": {},
    "session": [],
    "ui": { "containers": ["preview", "tab", "drawer", "dialog"] },
    "network": []
  }
}
