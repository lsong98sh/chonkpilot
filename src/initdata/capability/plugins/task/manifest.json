{
  "schema": "chonkpilot.plugin/v1",
  "id": "task",
  "name": "任务工具",
  "version": "1.0.0",
  "description": "任务系列工具：执行（task_run）/ LLM（task_llm）/ 状态（task_status）/ 终止（task_stop）",
  "icon": "play",
  "publisher": "chonkpilot",
  "product": true,
  "runtime": {
    "mode": "managed",
    "exe": "chonkpilot-plugin-task.exe",
    "args": [],
    "autostart": true,
    "restart": { "backoff_ms": 1000, "max_backoff_ms": 30000, "max_fails": 3 },
    "health": { "interval_ms": 15000, "timeout_ms": 3000, "fail_threshold": 3 },
    "stop": { "grace_ms": 8000 }
  },
  "mcp": {
    "mode": "http",
    "namespace": "-",
    "hot_tools": ["task_run", "task_llm", "task_status", "task_stop"],
    "timeout_sec": 600,
    "category": "task",
    "origin": "builtin"
  },
  "config": { "scope": "plugin" },
  "ui": {
    "selfServe": true,
    "views": [
      {
        "id": "config",
        "title": "任务工具",
        "icon": "play",
        "entry": "webui/config.html",
        "containers": ["preview", "tab", "drawer", "dialog"],
        "default_size": { "width": 760, "height": 620 }
      }
    ],
    "menus": [
      { "location": "plugin", "label": "任务工具", "icon": "play", "view": "config" }
    ],
    "statusbar": [],
    "rpc": ["status", "ping", "load", "save", "reset"]
  },
  "permissions": {
    "data": ["task.tree", "task.tasks", "task.stop"],
    "hooks": [],
    "llm": { "step": true },
    "session": [],
    "ui": { "containers": ["preview", "tab", "drawer", "dialog"] },
    "network": []
  }
}
