  },
  "env": {
    "CHONKPILOT_WORKDIR": "项目工作目录",
    "CHONKPILOT_DATADIR": "数据目录",
    "CHONKPILOT_TEMPDIR": "临时目录根",
    "CHONKPILOT_EXEDIR": "可执行文件所在目录",
    "CHONKPILOT_PROJECT": "项目目录（同 WORKDIR）"
