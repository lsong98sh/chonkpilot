# ============================================================================
# ChonkPilot .gitignore
# 原则：**源 / 产物分区**（[41 D-28]）—— `src/` 与 `docs/` 入库，`dist/` 与
#       构建脚本投放出的 `frontend/dist`、运行时数据、二进制一律不入库。
# ============================================================================

# ── 1. 构建产物（仓库根，由 build-*.ps1 产出）──────────────────────────────
# dist/：chonkpilot.exe · chonkpilot-remote-server.exe(+.db) · themes/ · capability/
# build/plugin-apps/：插件 staging（build-plugins.ps1 产出，不入库）
/dist/
/build/

# ── 2. 前端构建投放物（go:embed 入口，由 build 脚本生成）────────────────────
# 源 = 仓库级 src/frontend；唯一产物 = src/desktop/frontend/dist（桌面壳 go:embed 落点）
/src/frontend/dist/
/src/desktop/frontend/dist/
# 历史残留（browser 形态已删除、脚本不再产出；本地可能仍有旧目录 → 继续忽略防误提交）
/src/frontend/dist-browser/
/src/frontend/node_modules/
node_modules/
.vite/

# ── 3. 二进制 / 原生库（源码树内一律不入库；发行物只出现在 dist/）───────────
*.exe
*.dll
# 注（2026-10-27）：vfts/codegraph 引擎源码与 zvec 原生库已随插件迁至 `chonkpilot-plugins` 仓
# （`codegraph/engines/vfts/third_party/zvec`），主仓不再持有 dll，原负模式例外随之删除。
*.so
*.dylib
*.test
*.test.exe
*.out

# ── 4. 运行时数据（各 work_dir 下的项目数据根）──────────────────────────────
# 含 prj/prjusr 库、capability/、scenarios/、logs/、tmp/、backup/、memory/
# 注：用户级数据根 ~/.chonkpilot/ 在仓库外，天然不入库
.chonkpilot/

# ── 5. 测试工作区产物（L2/L3 运行残留 + 明文凭据）─────────────────────────
# java-project 等会产出 jar/class/surefire 报告/库文件，并可能落明文 token
# systest 运行残留：`_` 前缀目录全部为产物——各用例隔离 data-dir（`_*_data/chonkpilot.db`）、
# 配置截图（`_cfg_ui_shots/*.png`）、临时工作区（`_prev_ws/`）、探针目录（`_*probe*/`）。
# 用例源码 `*.py` 位于 systest 根，不在此规则内。
/src/test/chonkpilot-gui/systest/_*/
# 共享工作区 `systest/ws` 内的运行产物（其输入夹具 sample.* / f01~f11.txt 仍入库）
/src/test/chonkpilot-gui/systest/ws/g11-batch.json
/src/test/**/workspace/
/src/test/**/target/
/src/test/**/*.class
/src/test/**/*.jar
/src/test/**/token.txt
/src/test/**/login_out.json
*.surefire/

# ── 6. 日志 / 诊断 ─────────────────────────────────────────────────────────
.ide/
.ide/logs/
logs/
*.log

# ── 7. 临时文件 / Python 缓存（L2 systest、llmproxy 等 .py 产物）─────────────
tmp/
temp/
*.tmp
*.bak
__pycache__/
*.pyc
*.pyo

# mcps 文档转换服务（Python 源工程，src/mcps/markitdown）的本地 venv 与冻结中间物
/src/mcps/markitdown/.venv/
/src/mcps/markitdown/build/
/src/mcps/markitdown/dist/
/src/mcps/markitdown/*.spec
# 运行时状态文件（含 X-Chonk-Token，绝不能进库）
/src/mcps/markitdown/state.json
/src/mcps/markitdown/state.json.tmp
# 自测生成的样本（selftest.py 会自动重建，不入库）
/src/mcps/markitdown/samples/generated/

# ── 8. Go 工作区（多模块由 go.mod 各自管理；本机 workspace 不入库）──────────
go.work
go.work.sum
vendor/

# ── 9. 历史归档 / 技术验证（不入库）────────────────────────────────────────
# trash/     = 已废弃的旧代码 / 旧文档 / 探针脚本 / 第三方参考项目
# TECH-POC/  = 技术可行性验证用（如 webview2-multiwin、webview2-cookie），非产品代码
/trash/
/TECH-POC/

# ── 10. 环境变量 / 凭据 ────────────────────────────────────────────────────
.env
.env.*
*.env.local
*.env.*.local

# ── 11. IDE / 编辑器 ───────────────────────────────────────────────────────
.trae/
.specx/
.idea/
.vscode/
*.swp
*.swo
*~

# ── 12. 操作系统 ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.cab
*.lnk

# ── 13. 本机私有笔记（不入库）─────────────────────────────────────────────
/AGENTS.md
/TODO.md
/硬编码参数分析.md
/tools/
# 外部参考材料（claude-ux 技能原文 / 各类提示词参考）：仅供本机取用，不入库
/prompts-ref/

# ── 14. 契约 embed 构建期副本（GATEWAY-2 C）────────────────────────────────
# `src/lib/mcp-server/server/contracts/**` = 构建脚本从 src/initdata/capability 覆盖同步的
# //go:embed 副本（唯一源在原处，不入库）；仅 `.gitkeep` 占位入库，保证 clean clone 可编译。
/src/lib/mcp-server/server/contracts/*
!/src/lib/mcp-server/server/contracts/.gitkeep

# 本机构建/临时产物
/.diff_tmp.txt
/src/desktop/*.syso
